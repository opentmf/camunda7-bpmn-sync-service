      <bpmn:documentation>${taskDescriptionObject}</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="pstnMainNumber" label="Main PSTN Number" type="string">
            <camunda:properties>
              <camunda:property id="relatedProductOfferingID" value="UCMainNumberOffering" />
              <camunda:property id="relatedSalesQuantity" value="0" />
              <camunda:property id="relatedDataType" value="string" />
              <camunda:property id="characteristicName" value="mainNumber" />
            </camunda:properties>
            <camunda:validation>
              <camunda:constraint name="required" config="true" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="siteName" label="Customer Site Name" type="string">
            <camunda:properties>
              <camunda:property id="relatedProductOfferingID" value="UCMainNumberOffering" />
              <camunda:property id="relatedSalesQuantity" value="0" />
              <camunda:property id="relatedDataType" value="string" />
              <camunda:property id="characteristicName" value="siteName" />
            </camunda:properties>
            <camunda:validation>
              <camunda:constraint name="required" config="true" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="numberType" label="Number Type" type="enum">
            <camunda:properties>
              <camunda:property id="relatedProductOfferingID" value="UCMainNumberOffering" />
              <camunda:property id="relatedSalesQuantity" value="0" />
              <camunda:property id="relatedDataType" value="string" />
              <camunda:property id="characteristicName" value="numberType" />
            </camunda:properties>
            <camunda:validation>
              <camunda:constraint name="required" config="true" />
            </camunda:validation>
            <camunda:value id="PSTNGeoNumberOffering" name="Geo" />
            <camunda:value id="PSTNNonGeoNumberOffering" name="Non-Geo" />
            <camunda:value id="PSTNNomadicNumberOffering" name="Nomadic" />
          </camunda:formField>
        </camunda:formData>
