    <bpmn:sequenceFlow id="Flow_1u22xt7" sourceRef="uc_preparePayloadAddNumbers" targetRef="uc_postServiceOrder" />
    <bpmn:serviceTask id="uc_initServiceOrderFlow" name="Init Service Order Flow" camunda:type="external" camunda:topic="uc_initServiceOrderFlow">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="currentProcessInstanceId">${execution.getProcessInstanceId()}</camunda:inputParameter>
          <camunda:inputParameter name="requestType">addNumbers</camunda:inputParameter>
          <camunda:outputParameter name="waitDurationAddNumbers">${waitDurationAddNumbers}</camunda:outputParameter>
          <camunda:outputParameter name="requestType">${requestType}</camunda:outputParameter>
          <camunda:outputParameter name="flowId">${flowId}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yukfvt</bpmn:incoming>
      <bpmn:outgoing>Flow_1ppqfkz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="uc_preparePayloadAddNumbers" name="Prepare Payload Add Numbers" camunda:type="external" camunda:topic="uc_preparePayloadAddNumbers">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="productOrderID">${productOrderID}</camunda:inputParameter>
          <camunda:inputParameter name="productOrderItemID">${productOrderItemID}</camunda:inputParameter>
          <camunda:inputParameter name="flowId">${flowId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ppqfkz</bpmn:incoming>
      <bpmn:outgoing>Flow_1u22xt7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="uc_postServiceOrder" name="Post Service Order" camunda:asyncBefore="true" camunda:type="external" camunda:topic="uc_postServiceOrder">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="flowId">${flowId}</camunda:inputParameter>
          <camunda:outputParameter name="serviceOrderId">${serviceOrderId}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1u22xt7</bpmn:incoming>
      <bpmn:outgoing>Flow_0keu4w1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0keu4w1" sourceRef="uc_postServiceOrder" targetRef="uc_sendServiceOrderCreatedMail" />
    <bpmn:sequenceFlow id="triggerPoll" name="Trigger Poll" sourceRef="ifNoStatusUpdateYet" targetRef="uc_pollServiceOrder" />
    <bpmn:exclusiveGateway id="Gateway_1le6h6j" default="Flow_11s9953">
      <bpmn:incoming>Flow_1a348xs</bpmn:incoming>
      <bpmn:outgoing>Flow_11s9953</bpmn:outgoing>
      <bpmn:outgoing>Flow_0413i4k</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="uc_pollServiceOrder" name="Poll Service Order" camunda:type="external" camunda:topic="uc_pollServiceOrder">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceOrderId">${serviceOrderId}</camunda:inputParameter>
          <camunda:inputParameter name="flowId">${flowId}</camunda:inputParameter>
          <camunda:outputParameter name="isFinalState">${isFinalState}</camunda:outputParameter>
          <camunda:outputParameter name="status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="emailDescription">${emailDescription}</camunda:outputParameter>
          <camunda:outputParameter name="errorCode">${errorCode}</camunda:outputParameter>
          <camunda:outputParameter name="errorMessage">${errorMessage}</camunda:outputParameter>
          <camunda:outputParameter name="errorReason">${errorReason}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>triggerPoll</bpmn:incoming>
      <bpmn:outgoing>Flow_0bcmsak</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="uc_addNumbers_waitForStatusUpdate" name="Wait For Status Update" messageRef="Message_17mih9t">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="serviceOrderId">${serviceOrderId}</camunda:inputParameter>
        </camunda:inputOutput>
