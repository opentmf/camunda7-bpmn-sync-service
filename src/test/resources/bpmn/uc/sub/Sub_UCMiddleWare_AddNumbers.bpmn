      <bpmn:incoming>Flow_11s9953</bpmn:incoming>
      <bpmn:outgoing>Flow_1pk3k98</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="ifNoStatusUpdateYet" name="If No Status Update Yet" attachedToRef="uc_addNumbers_waitForStatusUpdate">
      <bpmn:outgoing>triggerPoll</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_11ji6t1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${waitDurationAddNumbers}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="uc_parseAddedAndFailedNumbers" name="Parse Added And Failed Numbers" camunda:type="external" camunda:topic="uc_parseAddedAndFailedNumbers">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="flowId">${flowId}</camunda:inputParameter>
          <camunda:outputParameter name="isAllNumbersCollected">${isAllNumbersCollected}</camunda:outputParameter>
