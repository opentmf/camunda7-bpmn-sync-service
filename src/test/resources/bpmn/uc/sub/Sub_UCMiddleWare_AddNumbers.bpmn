    <bpmn:sequenceFlow id="Flow_1pk3k98" sourceRef="uc_sendAddNumbersFailedMail" targetRef="Event_0q5emzh" />
    <bpmn:sequenceFlow id="Flow_0413i4k" name="${status == &#34;completed&#34;}" sourceRef="Gateway_1le6h6j" targetRef="uc_sendServiceOrderCompletedMail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "completed"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1aafih0" default="Flow_0smvlo2">
      <bpmn:incoming>Flow_0bcmsak</bpmn:incoming>
      <bpmn:incoming>Flow_04wd3kg</bpmn:incoming>
