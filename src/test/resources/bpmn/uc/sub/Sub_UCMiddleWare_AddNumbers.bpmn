    </bpmn:receiveTask>
    <bpmn:serviceTask id="uc_sendAddNumbersFailedMail" name="Send Add Numbers Failed Mail" camunda:type="external" camunda:topic="uc_prepareAndSendEmail">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailTemplateName">AddNumbersFailed</camunda:inputParameter>
          <camunda:inputParameter name="emailTo" />
          <camunda:inputParameter name="emailCc" />
          <camunda:inputParameter name="emailSubject">Service Order Failed ([requestType])</camunda:inputParameter>
