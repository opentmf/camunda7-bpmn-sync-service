    <bpmn:sequenceFlow id="Flow_0l8oy2f" name="${isFinalState}" sourceRef="Gateway_1aafih0" targetRef="uc_parseAddedAndFailedNumbers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isFinalState}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0smvlo2" sourceRef="Gateway_1aafih0" targetRef="uc_addNumbers_waitForStatusUpdate" />
    <bpmn:sequenceFlow id="Flow_0bcmsak" sourceRef="uc_pollServiceOrder" targetRef="Gateway_1aafih0" />
