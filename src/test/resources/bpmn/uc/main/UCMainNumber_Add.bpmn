      <bpmn:outgoing>Flow_1h1q3hu</bpmn:outgoing>
      <bpmn:outgoing>Flow_06as4xq</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_02los57" sourceRef="uc_Sub_HT_CorrectProblem" targetRef="Gateway_0fs52fh" />
    <bpmn:sequenceFlow id="Flow_1h1q3hu" name="${status == &#34;retry&#34;}" sourceRef="Gateway_0fs52fh" targetRef="updateUCCache">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "retry"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06as4xq" name="${status == &#34;completed&#34;}" sourceRef="Gateway_0fs52fh" targetRef="uc_updateServiceOrderStatus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == "completed"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1c60fma" sourceRef="uc_updateServiceOrderStatus" targetRef="uc_markMainNumberCollected" />
