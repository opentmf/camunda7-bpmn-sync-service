        <camunda:inputOutput>
          <camunda:inputParameter name="taskDescription">Collect Main PSTN Number for productOrderId = ${productOrderID}. 
Customer site names:  ${customerSiteNames}</camunda:inputParameter>
          <camunda:inputParameter name="notificationType">starter</camunda:inputParameter>
          <camunda:inputParameter name="processSubStep">- Enter Main Number</camunda:inputParameter>
          <camunda:inputParameter name="processStep">UC Unity Order</camunda:inputParameter>
          <camunda:inputParameter name="productOrderName">VBUC Main Number</camunda:inputParameter>
          <camunda:outputParameter name="pstnMainNumber">${pstnMainNumber}</camunda:outputParameter>
          <camunda:outputParameter name="numberType">${numberType}</camunda:outputParameter>
          <camunda:outputParameter name="siteName">${siteName}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:out variables="all" />
        <camunda:in variables="all" />
      </bpmn:extensionElements>
