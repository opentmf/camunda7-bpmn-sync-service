    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_1ksemqq" sourceRef="uc_Sub_Onboard_MainNumber" targetRef="Event_0iddvdr" />
    <bpmn:serviceTask id="validateMainNumber" name="Validate Main Number" camunda:type="external" camunda:topic="uc_validateMainNumber">
