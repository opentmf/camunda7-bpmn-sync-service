    <bpmn:callActivity id="uc_Sub_HT_CorrectProblem" name="Sub HT Correct Problem" calledElement="uc_Sub_HT_CorrectProblem">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="processStep">UC Unity Order</camunda:inputParameter>
          <camunda:inputParameter name="processSubStep">- Correct Problem</camunda:inputParameter>
          <camunda:inputParameter name="taskDescription">Unable to add main number (${pstnMainNumber}) for product order id = "${productOrderID}" and product order item id = "${productOrderItemID}". Indicated status value from UC Middleware = "${status}". Error Code: ${errorCode},  Error Reason: ${errorReason}, Error Message: ${errorMessage}  Please choose next action.</camunda:inputParameter>
          <camunda:inputParameter name="notificationType">starter</camunda:inputParameter>
          <camunda:inputParameter name="productOrderName">VBUC Account Creation Problems</camunda:inputParameter>
          <camunda:inputParameter name="rcUid">${rcUid}</camunda:inputParameter>
          <camunda:outputParameter name="status">${status}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:out variables="all" />
        <camunda:in variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tj1jx1</bpmn:incoming>
      <bpmn:outgoing>Flow_02los57</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_0fs52fh">
