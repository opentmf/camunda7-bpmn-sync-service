    <bpmn:sequenceFlow id="Flow_18kltnt" sourceRef="Gateway_06t5on1" targetRef="uc_Sub_HT_CollectPSTNNumbers" />
    <bpmn:sequenceFlow id="Flow_0v73gey" name="All Clip/PortIn numbers collected" sourceRef="Gateway_06t5on1" targetRef="Event_0iddvdr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${portInCountToCollect == 0 &amp;&amp; clipCountToCollect == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
