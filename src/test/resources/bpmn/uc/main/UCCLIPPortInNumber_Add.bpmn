    <bpmn:sequenceFlow id="Flow_0mrdcp3" sourceRef="Event_0iryjtp" targetRef="uc_sendValidateNumbersFailedMail" />
    <bpmn:exclusiveGateway id="Gateway_06t5on1" default="Flow_18kltnt">
      <bpmn:incoming>Flow_1xejarf</bpmn:incoming>
      <bpmn:outgoing>Flow_18kltnt</bpmn:outgoing>
      <bpmn:outgoing>Flow_0v73gey</bpmn:outgoing>
