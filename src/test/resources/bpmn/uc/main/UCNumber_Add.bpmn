    <bpmn:sequenceFlow id="Flow_18kltnt" sourceRef="Gateway_06t5on1" targetRef="uc_Sub_HT_CollectPSTNNumbers" />
    <bpmn:sequenceFlow id="Flow_0v73gey" name="${numberCountToCollect == 0}" sourceRef="Gateway_06t5on1" targetRef="Event_0iddvdr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${numberCountToCollect == 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
