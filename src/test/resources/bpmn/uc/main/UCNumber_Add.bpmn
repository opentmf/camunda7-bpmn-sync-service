<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_13gg98w" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.7.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.15.0">
  <bpmn:process id="UCNumber_Add" name="UC Number Add" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0scdpsa</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0scdpsa" sourceRef="StartEvent_1" targetRef="uc_prepareCollectPSTNNumbersContext" />
    <bpmn:callActivity id="uc_Sub_HT_CollectPSTNNumbers" name="Sub HT Collect PSTN Numbers" camunda:asyncBefore="true" calledElement="uc_Sub_HT_CollectPSTNNumbers">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskDescription">Please provide${retryCount == 0 ? "" : " additional"} ${humanReadableNumberType} PSTN Numbers 
${(siteName == "" || siteName == null) ? "" : " for Site Name: "} ${(siteName == "" || siteName == null) ? "" : siteName}. 
${numberCountToCollect} FIXED numbers, 
${portInCountToCollect &gt; 0 ? "Optionally at most " : ""}${portInCountToCollect} PORTIN numbers,
${clipCountToCollect &gt; 0 ? "Optionally at most " : ""}${clipCountToCollect} CLIP numbers. 
NOTE: Original Number Count Requested: ${originalNumberCountToCollect}</camunda:inputParameter>
          <camunda:inputParameter name="notificationType">starter</camunda:inputParameter>
          <camunda:inputParameter name="processSubStep">- Enter PSTN Numbers</camunda:inputParameter>
          <camunda:inputParameter name="processStep">UC Unity Order</camunda:inputParameter>
          <camunda:inputParameter name="humanReadableNumberType">${humanReadableNumberType}</camunda:inputParameter>
          <camunda:inputParameter name="numberCountToCollect">${numberCountToCollect}</camunda:inputParameter>
          <camunda:inputParameter name="originalNumberCountToCollect">${originalNumberCountToCollect}</camunda:inputParameter>
          <camunda:inputParameter name="siteName">${siteName}</camunda:inputParameter>
          <camunda:inputParameter name="clipCountToCollect">${clipCountToCollect}</camunda:inputParameter>
          <camunda:inputParameter name="portInCountToCollect">${portInCountToCollect}</camunda:inputParameter>
          <camunda:inputParameter name="productOrderName">VBUC PSTN ${humanReadableNumberType}${(siteName == "" || siteName == null) ? "" : " -"} ${(siteName == "" || siteName == null) ? "" : siteName}</camunda:inputParameter>
          <camunda:outputParameter name="csvFileId">${csvFileId}</camunda:outputParameter>
        </camunda:inputOutput>
        <camunda:out variables="all" />
        <camunda:in variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1l2h03a</bpmn:incoming>
      <bpmn:incoming>Flow_18kltnt</bpmn:incoming>
      <bpmn:outgoing>Flow_0wc2cep</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="uc_Sub_UCMiddleWare_AddNumbers" name="Sub UCMiddleWare Add Numbers" camunda:asyncBefore="true" calledElement="uc_Sub_UCMiddleWare_AddNumbers">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="csvFileId">${csvFileId}</camunda:inputParameter>
        </camunda:inputOutput>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0kvzcjr</bpmn:incoming>
      <bpmn:outgoing>Flow_0iag0i8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_0wc2cep" sourceRef="uc_Sub_HT_CollectPSTNNumbers" targetRef="uc_validateNumbers" />
    <bpmn:endEvent id="Event_0iddvdr">
      <bpmn:incoming>Flow_allNumbersCollected</bpmn:incoming>
      <bpmn:incoming>Flow_0v73gey</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="uc_Sub_OnboardPSTNNumbers" name="Sub Onboard PSTN Numbers" calledElement="uc_Sub_OnboardPSTNNumbers">
      <bpmn:extensionElements>
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0eb05of</bpmn:incoming>
      <bpmn:outgoing>Flow_04ke1wf</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_allNumbersCollected" name="${isAllNumbersCollected}" sourceRef="Gateway_06t5c97" targetRef="Event_0iddvdr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isAllNumbersCollected}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04ke1wf" sourceRef="uc_Sub_OnboardPSTNNumbers" targetRef="Gateway_06t5c97" />
    <bpmn:sequenceFlow id="Flow_0cmjfzg" sourceRef="Gateway_06t5c97" targetRef="uc_prepareCollectPSTNNumbersContext" />
    <bpmn:sequenceFlow id="Flow_0kvzcjr" sourceRef="uc_validateNumbers" targetRef="uc_Sub_UCMiddleWare_AddNumbers" />
    <bpmn:serviceTask id="uc_validateNumbers" name="Validate Numbers" camunda:type="external" camunda:topic="uc_validateNumbers">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="csvFileId">${csvFileId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wc2cep</bpmn:incoming>
      <bpmn:outgoing>Flow_0kvzcjr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="uc_sendValidateNumbersFailedMail" name="Send Validate Numbers Failed Mail" camunda:type="external" camunda:topic="uc_prepareAndSendEmail">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailTemplateName">ValidateNumbersFailed</camunda:inputParameter>
          <camunda:inputParameter name="emailSubject">Validate Numbers Failed (orderId = [productOrderID], orderItemId = [productOrderItemID])</camunda:inputParameter>
          <camunda:inputParameter name="emailTo" />
          <camunda:inputParameter name="emailCc" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0mrdcp3</bpmn:incoming>
      <bpmn:outgoing>Flow_1l2h03a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1l2h03a" sourceRef="uc_sendValidateNumbersFailedMail" targetRef="uc_Sub_HT_CollectPSTNNumbers" />
    <bpmn:exclusiveGateway id="Gateway_06t5c97" default="Flow_0cmjfzg">
      <bpmn:incoming>Flow_0i9awhi</bpmn:incoming>
      <bpmn:incoming>Flow_04ke1wf</bpmn:incoming>
