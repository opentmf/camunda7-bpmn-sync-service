<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{mm:ss.SSS} %-5level [%thread] %class{1} -- %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org" level="INFO" />
  <logger name="com" level="INFO" />
  <logger name="javax" level="INFO" />
  <logger name="reactor" level="INFO" />
  <logger name="io" level="INFO" />

  <logger name="org.springframework" level="INFO" />
  <logger name="reactor.netty.http.client" level="WARN"/>
  <logger name="org.zalando.logbook" level="INFO" />

  <logger name="org.camunda" level="INFO" />
  <logger name="com.pia" level="TRACE" />
  <logger name="com.pia.sh.client.token" level="DEBUG" />
  <logger name="com.pia.sh.db.lock" level="DEBUG" />
  <logger name="com.pia.security.jwt" level="INFO" />

  <logger name="org.mockserver" level="WARN" />

  <root level="TRACE">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
